# Copy to .env and adjust. docker compose reads this file automatically.
# local = demo stack. production refuses demo seeding (APP_DEMO is ignored).
APP_ENV=local
APP_DEBUG=0
APP_TIMEZONE=America/Bogota

# Host ports (project range 8140-8149)
WEB_PORT=8140
DB_PORT=8141

# PostgreSQL connection used by the application
DB_HOST=db
DB_DATABASE=cine
DB_USERNAME=cine
DB_PASSWORD=change-me-local-only

# Load demo accounts, data and rolling showtimes on start (never in production)
APP_DEMO=1
