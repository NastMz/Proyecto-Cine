# Copy to .env and adjust. docker compose reads this file automatically.
APP_ENV=production
APP_DEBUG=0
APP_TIMEZONE=America/Bogota

# Host ports (project range 8140-8149)
WEB_PORT=8140
DB_PORT=8141

# PostgreSQL connection used by the application
DB_HOST=db
DB_DATABASE=cine
DB_USERNAME=cine
DB_PASSWORD=change-me-local-only

# Load demo data (seed + rolling showtimes) on start
APP_DEMO=1
